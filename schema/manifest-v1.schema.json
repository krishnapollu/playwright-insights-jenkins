{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:playwright-insights:manifest:1.1.0",
  "title": "Playwright Insights manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "producer", "run", "projects", "tests", "warnings"],
  "properties": {
    "schemaVersion": { "enum": ["1.0.0", "1.1.0"] },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "startedAt", "durationMs", "complete"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "durationMs": { "$ref": "#/$defs/duration" },
        "complete": { "type": "boolean" },
        "comparisonKey": { "type": "string", "minLength": 1, "maxLength": 256 },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "branch": { "type": "string", "maxLength": 256 },
            "commit": { "type": "string", "maxLength": 128 },
            "selection": { "type": "string", "maxLength": 512 }
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "name": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    },
    "tests": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "projectId", "file", "line", "titlePath", "repeatEachIndex", "expectedStatus", "outcome", "attempts"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "file": { "$ref": "#/$defs/relativePath" },
          "line": { "type": "integer", "minimum": 1 },
          "titlePath": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": { "type": "string", "minLength": 1, "maxLength": 512 }
          },
          "repeatEachIndex": { "type": "integer", "minimum": 0 },
          "expectedStatus": { "enum": ["passed", "failed", "timedOut", "skipped", "interrupted"] },
          "outcome": { "enum": ["expected", "unexpected", "flaky", "skipped"] },
          "tags": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
          "annotations": {
            "type": "array", "maxItems": 16,
            "items": { "type": "object", "additionalProperties": false, "required": ["type"],
              "properties": { "type": { "type": "string", "minLength": 1, "maxLength": 128 }, "description": { "type": "string", "maxLength": 512 } } }
          },
          "attempts": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["retry", "status", "durationMs", "errors", "attachments"],
              "properties": {
                "retry": { "type": "integer", "minimum": 0, "maximum": 15 },
                "status": { "enum": ["passed", "failed", "timedOut", "skipped", "interrupted"] },
                "durationMs": { "$ref": "#/$defs/duration" },
                "workerIndex": { "type": "integer", "minimum": -1 },
                "stdout": { "type": "string", "maxLength": 4096 },
                "stderr": { "type": "string", "maxLength": 4096 },
                "steps": {
                  "type": "array", "maxItems": 128,
                  "items": { "type": "object", "additionalProperties": false,
                    "required": ["title", "category", "durationMs", "depth"],
                    "properties": {
                      "title": { "type": "string", "minLength": 1, "maxLength": 256 },
                      "category": { "type": "string", "minLength": 1, "maxLength": 64 },
                      "durationMs": { "$ref": "#/$defs/duration" },
                      "depth": { "type": "integer", "minimum": 0, "maximum": 4 },
                      "error": { "type": "string", "maxLength": 1024 }
                    }
                  }
                },
                "errors": {
                  "type": "array",
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["message"],
                    "properties": {
                      "message": { "type": "string", "maxLength": 8192 },
                      "stack": { "type": "string", "maxLength": 32768 }
                    }
                  }
                },
                "attachments": {
                  "type": "array",
                  "maxItems": 16,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "contentType", "path"],
                    "properties": {
                      "name": { "type": "string", "minLength": 1, "maxLength": 256 },
                      "contentType": { "type": "string", "minLength": 1, "maxLength": 128 },
                      "path": { "$ref": "#/$defs/relativePath" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    }
  },
  "$defs": {
    "duration": { "type": "integer", "minimum": 0 },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!\\.{1,2}(?:/|$))[A-Za-z0-9_@()+, .=-]+(/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_@()+, .=-]+)*$"
    }
  }
}
